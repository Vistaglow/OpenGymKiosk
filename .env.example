# Copy to .env and fill in.

# Opens the kiosk on a new device: visit http://<this mac>:8090/enroll?key=<KIOSK_KEY> once on
# the iPad. Without it the kiosk shows nothing but a "not enrolled" page. Long and random.
KIOSK_KEY=

# What the rep sensor sends as `Authorization: Bearer <SENSOR_TOKEN>`. Put the same value in
# firmware/rep_counter/rep_counter.ino.
SENSOR_TOKEN=

# The port on this Mac the kiosk answers on.
KIOSK_PORT=8090

# The voice a newly paired profile starts with (any phonon voice).
TTS_DEFAULT_VOICE=Captain Silas Blackwater

# Defaults, change only if your setup differs.
# OPENGYM_API=http://api:3000
# OPENGYM_WEB=http://web:80
# TTS_URL=http://host.docker.internal:11434
# TTS_MODEL=phonon
